# ---- API (server/) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/samouna
# Long random string. Required in production.
JWT_SECRET=change-me
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Set to 1 when running behind Railway/Render/a load balancer
TRUST_PROXY=0

# Meta WhatsApp Cloud API. Leave blank in development: codes are printed
# to the API console and returned in the response as `devCode`.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# An approved "Authentication" category template with a copy-code button
META_OTP_TEMPLATE=samouna_otp
META_OTP_HAS_BUTTON=true

# ---- Frontends (apps/*) ----
# Leave empty in dev (Vite proxies /api and /ws to localhost:4000)
VITE_API_URL=
